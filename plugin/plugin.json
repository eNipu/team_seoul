{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "venn",
  "version": "0.1.0",
  "description": "Keep private notes about people you know, find shared interests, and plan time together.",
  "author": {
    "name": "Venn",
    "url": "https://joinvennai.com"
  },
  "homepage": "https://joinvennai.com",
  "license": "UNLICENSED",
  "keywords": [
    "social",
    "friends",
    "memories",
    "relationships",
    "companion"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Venn",
        "shortDescription": "Keep private notes about people you know and plan time together.",
        "longDescription": "Connect your AI memories. Build your inner circle. Venn quietly tells you when a friend is nearby, working on something you care about, or looking for what you have — right inside ChatGPT.",
        "developerName": "Venn",
        "category": "Lifestyle",
        "capabilities": [
          "Interactive",
          "Write"
        ],
        "websiteURL": "https://joinvennai.com",
        "privacyPolicyURL": "https://joinvennai.com/privacy",
        "defaultPrompt": [
          "Open Venn",
          "Guide me through Venn setup",
          "What's new with my people?"
        ],
        "brandColor": "#FCD305",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/logo.png"
      },
      "onboardingSkill": "./skills/venn-social/SKILL.md"
    }
  }
}
