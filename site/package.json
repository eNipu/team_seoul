{
  "name": "heldly-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf public/js && esbuild src/main.js --bundle --splitting --format=esm --minify --target=es2020 --outdir=public/js --entry-names=[name] --chunk-names=[name]-[hash] --legal-comments=linked",
    "check": "node check.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "three": "0.187.0",
    "@fontsource/caveat": "5.3.0"
  }
}
