# Postgres for the waitlist and metrics. Required in production.
DATABASE_URL=postgresql://postgres:venn@127.0.0.1:55432/venn

# Password for /metrics (HTTP Basic auth, any user name). Required in production:
# without it /metrics answers 503.
METRICS_PASSWORD=

# Optional secret mixed into the anonymous visitor hash. Falls back to DATABASE_URL.
ANALYTICS_SALT=

# Meta Pixel ID (digits). Leave empty to load no pixel.
NEXT_PUBLIC_META_PIXEL_ID=

# Microsoft Clarity project ID. Leave empty to load no Clarity script.
NEXT_PUBLIC_CLARITY_ID=

# Server-only Resend key with sending access to verified domain joinvennai.com.
RESEND_API_KEY=
# Optional monitored inbox for replies to signup receipts.
WAITLIST_REPLY_TO=
