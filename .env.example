# ---- Venn backend configuration -------------------------------------------
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# SQLite (default, dev) or Postgres/Supabase, e.g.
# postgresql://venn:venn@localhost:5432/venn
# postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./venn.db

# Optional; only needed if you use Supabase-hosted Postgres features beyond DATABASE_URL.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Without a key, memory extraction falls back to a local heuristic.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional. Apify API token (https://console.apify.com/settings/integrations).
# Used by the LinkedIn import on the website to fetch profile details for the
# connections the user picks. Without it, the import uses name + headline only.
APIFY_TOKEN=

# Public URL of this server (what ChatGPT reaches, e.g. an ngrok/cloudflared tunnel).
PUBLIC_BASE_URL=http://localhost:8081
# Defaults to $PUBLIC_BASE_URL/mcp
MCP_BASE_URL=

# ---- Auth -------------------------------------------------------------------
# dev: built-in development OAuth server (DCR + PKCE + simple sign-in page). Refused in production.
# jwt: validate access tokens from your identity provider (Auth0, Clerk, Supabase Auth, ...).
AUTH_MODE=dev
DEV_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Optional shared passcode required on the dev sign-in page (recommended when tunneling).
DEV_AUTH_PASSCODE=

# Required when AUTH_MODE=jwt (always in production)
OAUTH_ISSUER=
OAUTH_AUDIENCE=
OAUTH_JWKS_URL=

# Extra Host headers to accept (JSON list), e.g. ["abc123.ngrok-free.app"]
ALLOWED_HOSTS=[]

# ---- Calendar (docs/tasks/SCHEDULING.md) -------------------------------------
# fake: in-memory calendar, nothing leaves the server. google: Google Calendar API v3.
CALENDAR_PROVIDER=fake
# OAuth client of type "Web application"; redirect URI $PUBLIC_BASE_URL/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Fernet key for stored refresh tokens. Required for google in production. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CALENDAR_TOKEN_KEY=
